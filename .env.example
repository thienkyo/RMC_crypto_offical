# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# ─── Database ────────────────────────────────────────────────────────────────
# Local Docker (matches docker-compose.yml):
DATABASE_URL=postgresql://rmc:rmc_dev_password@localhost:5432/rmc_crypto

# ─── Auth ────────────────────────────────────────────────────────────────────
APP_PASSWORD=change_me_before_using

# ─── Exchange Feeds (Optional) ───────────────────────────────────────────────
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# POLYGON_API_KEY=

# ─── AI API Keys & Configuration ─────────────────────────────────────────────
# Google Gemini (free tier available at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EVALUATOR_MODEL=gemini-2.0-flash

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_EVALUATOR_MODEL=claude-3-5-sonnet-20241022

# OpenAI ChatGPT (https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EVALUATOR_MODEL=gpt-4o

# ─── AI Token & Cost Limits ──────────────────────────────────────────────────
# Max output tokens generated per evaluation (default: 1024)
AI_EVALUATOR_MAX_TOKENS=1024

# ─── Automated Signal AI Gatekeeper (Optional) ───────────────────────────────
# Automatically runs AI evaluation when a strategy fires a signal (true/false)
ENABLE_AI_SIGNAL_GATEKEEPER=true

# ─── Telegram Bot & Alerts (Optional) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
